"""返航安全余量敏感性分析与 Nature 风格科研绘图。

运行前请把本文件与“问题一_机型与目标优先级对比代码.py”放在同一目录。
程序将：
1. 在10%--40%范围内按1个百分点改变返航安全余量；
2. 对每个安全余量重新二分计算三机型在15个服务区的最大安全载荷；
3. 重新求解货箱组批方案，而不是沿用20%安全余量下的分批结果；
4. 导出汇总CSV、详细安全载荷CSV以及SVG/PDF/TIFF/PNG多面板图片。

等效航程严格采用题目公式：
L_g(q) = L_g0 - (L_g0 - L_gF) * (q / Q_g) ** (3 / 2)
"""

from __future__ import annotations

import csv
import importlib.util
import math
from collections import Counter
from pathlib import Path

import matplotlib as mpl
import matplotlib.pyplot as plt
import numpy as np


SCRIPT_DIR = Path(__file__).resolve().parent
BASE_CODE = SCRIPT_DIR / "问题一_机型与目标优先级对比代码.py"

SUMMARY_CSV = SCRIPT_DIR / "返航安全余量敏感性分析_汇总.csv"
DETAIL_CSV = SCRIPT_DIR / "返航安全余量敏感性分析_安全载荷明细.csv"
FIGURE_STEM = SCRIPT_DIR / "返航安全余量敏感性分析_Nature多面板图"

RHO_VALUES = np.arange(0.10, 0.4001, 0.01)
TABLE_RHO_VALUES = {0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40}

COLORS = {
    "A": "#4C78A8",
    "B": "#72B7B2",
    "C": "#F2A65A",
    "main": "#2F4858",
    "accent": "#C44E52",
    "grid": "#D9D9D9",
    "infeasible": "#ECECEC",
}


from pathlib import Path
import importlib.util


def load_base_module():

    # 当前这个 wenti1.3.1.py 所在的文件夹
    current_dir = Path(__file__).resolve().parent

    # 要加载的基础代码
    base_path = current_dir / "wenti31.3.2.py"

    # 打印实际寻找位置，方便检查
    print("\n正在寻找基础代码：")
    print(base_path)

    # 检查文件是否存在
    if not base_path.exists():
        raise FileNotFoundError(
            f"\n没有找到基础代码：\n"
            f"{base_path}\n\n"
            f"请确认文件名为：\n"
            f"wenti31.3.2.py\n"
            f"并且与当前程序放在同一个文件夹。"
        )

    # 动态加载Python文件
    spec = importlib.util.spec_from_file_location(
        "batching_base",
        base_path
    )

    if spec is None or spec.loader is None:
        raise RuntimeError(
            "无法加载基础组批代码"
        )

    module = importlib.util.module_from_spec(spec)

    spec.loader.exec_module(module)

    print("基础代码加载成功！\n")

    return module


def max_safe_payload(base, route, model, rho, tolerance=1e-7):
    """利用能耗单调性，通过二分法求最大安全载荷。"""
    allowed_energy = (1.0 - rho) * model["usable_energy_kwh"]

    def is_safe(payload):
        return (
            base.batch_energy_kwh(route, model, payload)
            <= allowed_energy + 1e-12
        )

    if not is_safe(0.0):
        return 0.0, False

    rated_payload = model["rated_payload_kg"]
    if is_safe(rated_payload):
        return rated_payload, True

    left, right = 0.0, rated_payload
    while right - left > tolerance:
        middle = (left + right) / 2.0
        if is_safe(middle):
            left = middle
        else:
            right = middle
    return left, True


def build_safe_load_matrix(base, routes, parameters, rho):
    matrix = {}
    flight_feasible = {}
    for service, route in routes.items():
        matrix[service] = {}
        flight_feasible[service] = {}
        for model_name, model in parameters.items():
            payload, feasible = max_safe_payload(base, route, model, rho)
            matrix[service][model_name] = payload
            flight_feasible[service][model_name] = feasible
    return matrix, flight_feasible


def solve_one_rho(base, rho, routes, parameters, boxes_by_service):
    safe_loads, flight_feasible = build_safe_load_matrix(
        base, routes, parameters, rho
    )

    payload_stats = {}
    for model_name, model in parameters.items():
        values = np.array(
            [safe_loads[service][model_name] for service in sorted(safe_loads)],
            dtype=float,
        )
        payload_stats[model_name] = {
            "minimum": float(values.min()),
            "mean": float(values.mean()),
            "maximum": float(values.max()),
            "rated_route_count": int(
                np.isclose(values, model["rated_payload_kg"], atol=1e-5).sum()
            ),
            "empty_infeasible_count": sum(
                not flight_feasible[service][model_name]
                for service in flight_feasible
            ),
        }

    total_sorties = 0
    total_energy = 0.0
    total_time = 0.0
    model_counts = Counter()
    service_sorties = {}
    failure = None

    try:
        for service in sorted(boxes_by_service):
            result = base.solve_service(
                service,
                boxes_by_service[service],
                safe_loads,
                routes,
                parameters,
                tuple(parameters),
                ("sorties", "energy", "time"),
            )
            total_sorties += result[0]
            total_energy += result[1]
            total_time += result[2]
            service_sorties[service] = result[0]
            for _, model_name in result[3]:
                model_counts[model_name] += 1
    except RuntimeError as error:
        failure = str(error)

    batching_feasible = failure is None
    return {
        "rho": float(rho),
        "safe_loads": safe_loads,
        "payload_stats": payload_stats,
        "batching_feasible": batching_feasible,
        "failure": failure,
        "sorties": total_sorties if batching_feasible else math.nan,
        "energy_kwh": total_energy if batching_feasible else math.nan,
        "time_s": total_time if batching_feasible else math.nan,
        "time_h": total_time / 3600.0 if batching_feasible else math.nan,
        "model_counts": dict(sorted(model_counts.items())) if batching_feasible else {},
        "service_sorties": service_sorties if batching_feasible else {},
    }


def calculate_critical_reserves(base, routes, parameters, boxes_by_service):
    """计算图中使用的三个关键临界安全余量。"""
    s004_mass = sum(box["mass_kg"] for box in boxes_by_service["S004"])
    s008_mass = sum(box["mass_kg"] for box in boxes_by_service["S008"])

    s004_split = 1.0 - base.batch_energy_kwh(
        routes["S004"], parameters["C"], s004_mass
    ) / parameters["C"]["usable_energy_kwh"]
    s008_split = 1.0 - base.batch_energy_kwh(
        routes["S008"], parameters["C"], s008_mass
    ) / parameters["C"]["usable_energy_kwh"]

    mandatory = [
        box for box in boxes_by_service["S008"] if box["first_required"]
    ]
    mandatory_mass = sum(box["mass_kg"] for box in mandatory)
    mandatory_volume = sum(box["volume_m3"] for box in mandatory)
    limits = []
    for model in parameters.values():
        if (
            mandatory_mass <= model["rated_payload_kg"] + 1e-9
            and mandatory_volume <= model["volume_capacity_m3"] + 1e-12
        ):
            energy = base.batch_energy_kwh(routes["S008"], model, mandatory_mass)
            limits.append(1.0 - energy / model["usable_energy_kwh"])
    infeasible_limit = max(limits)

    return {
        "S004拆批": s004_split,
        "S008拆批": s008_split,
        "S008首批不可行": infeasible_limit,
    }


def export_source_data(results, parameters):
    summary_fields = [
        "安全余量",
        "是否可行",
        "往返架次",
        "完整能耗_kWh",
        "累计时间_h",
        "A型架次",
        "B型架次",
        "C型架次",
        "A型平均载荷",
        "B型平均载荷",
        "C型平均载荷",
        "A型最小载荷",
        "B型最小载荷",
        "C型最小载荷",
        "失败原因",
    ]
    with SUMMARY_CSV.open("w", encoding="utf-8-sig", newline="") as file:
        writer = csv.DictWriter(file, fieldnames=summary_fields)
        writer.writeheader()
        for result in results:
            writer.writerow(
                {
                    "安全余量": result["rho"],
                    "是否可行": result["batching_feasible"],
                    "往返架次": "" if math.isnan(result["sorties"]) else int(result["sorties"]),
                    "完整能耗_kWh": "" if math.isnan(result["energy_kwh"]) else result["energy_kwh"],
                    "累计时间_h": "" if math.isnan(result["time_h"]) else result["time_h"],
                    "A型架次": result["model_counts"].get("A", 0),
                    "B型架次": result["model_counts"].get("B", 0),
                    "C型架次": result["model_counts"].get("C", 0),
                    "A型平均载荷": result["payload_stats"]["A"]["mean"],
                    "B型平均载荷": result["payload_stats"]["B"]["mean"],
                    "C型平均载荷": result["payload_stats"]["C"]["mean"],
                    "A型最小载荷": result["payload_stats"]["A"]["minimum"],
                    "B型最小载荷": result["payload_stats"]["B"]["minimum"],
                    "C型最小载荷": result["payload_stats"]["C"]["minimum"],
                    "失败原因": result["failure"] or "",
                }
            )

    detail_fields = ["安全余量", "服务区", "机型", "最大安全载荷_kg"]
    with DETAIL_CSV.open("w", encoding="utf-8-sig", newline="") as file:
        writer = csv.DictWriter(file, fieldnames=detail_fields)
        writer.writeheader()
        for result in results:
            for service in sorted(result["safe_loads"]):
                for model_name in parameters:
                    writer.writerow(
                        {
                            "安全余量": result["rho"],
                            "服务区": service,
                            "机型": model_name,
                            "最大安全载荷_kg": result["safe_loads"][service][model_name],
                        }
                    )


