            "svg.fonttype": "none",
            "pdf.fonttype": 42,
            "font.size": 7,
            "axes.labelsize": 8,
            "axes.titlesize": 8.5,
            "xtick.labelsize": 7,
            "ytick.labelsize": 7,
            "legend.fontsize": 7,
            "axes.spines.right": False,
            "axes.spines.top": False,
            "axes.linewidth": 0.8,
            "legend.frameon": False,
            "figure.facecolor": "white",
            "axes.facecolor": "white",
        }
    )


def add_panel_label(ax, label):
    ax.text(
        -0.14,
        1.06,
        label,
        transform=ax.transAxes,
        fontsize=9,
        fontweight="bold",
        va="top",
        ha="left",
    )


def add_threshold_lines(ax, thresholds, include_labels=False):
    for name, value in thresholds.items():
        color = COLORS["accent"] if "不可行" in name else "#888888"
        ax.axvline(value * 100, color=color, lw=0.9, ls="--", zorder=1)
        if include_labels:
            ax.text(
                value * 100 + 0.25,
                0.98,
                f"{name}\n{value:.2%}",
                transform=ax.get_xaxis_transform(),
                ha="left",
                va="top",
                fontsize=6.2,
                color=color,
            )


def make_figure(results, parameters, thresholds):
    configure_matplotlib()

    rho_pct = np.array([result["rho"] * 100 for result in results])
    infeasible_start = thresholds["S008首批不可行"] * 100

    fig, axes = plt.subplots(2, 2, figsize=(7.2, 5.6), constrained_layout=False)
    ax_a, ax_b, ax_c, ax_d = axes.ravel()

    # a | 最大安全载荷：平均值作为主线，最小--最大范围作为浅色带。
    for model_name in parameters:
        means = np.array(
            [result["payload_stats"][model_name]["mean"] for result in results]
        )
        minima = np.array(
            [result["payload_stats"][model_name]["minimum"] for result in results]
        )
        maxima = np.array(
            [result["payload_stats"][model_name]["maximum"] for result in results]
        )
        color = COLORS[model_name]
        ax_a.fill_between(rho_pct, minima, maxima, color=color, alpha=0.12, lw=0)
        ax_a.plot(
            rho_pct,
            means,
            color=color,
            lw=1.8,
            marker="o",
            ms=2.6,
            markevery=5,
            label=f"{model_name}型",
        )
    ax_a.set_ylabel("最大安全载荷 (kg)")
    ax_a.set_title("机型载荷能力随安全余量下降")
    ax_a.legend(ncol=3, loc="lower left", handlelength=1.6, columnspacing=1.0)
    add_panel_label(ax_a, "a")

    # b | 架次阶跃。不可行结果保留为NaN，不用0误导读者。
    sorties = np.array([result["sorties"] for result in results], dtype=float)
    ax_b.step(rho_pct, sorties, where="post", color=COLORS["main"], lw=2.0)
    ax_b.scatter(rho_pct[np.isfinite(sorties)], sorties[np.isfinite(sorties)], s=10, color=COLORS["main"], zorder=3)
    ax_b.axvspan(infeasible_start, rho_pct.max(), color=COLORS["infeasible"], zorder=0)
    ax_b.text(
        37.2,
        20.7,
        "当前首批约束下\n不可行区间",
        ha="center",
        va="center",
        fontsize=6.5,
        color="#666666",
    )
    ax_b.set_ylabel("往返架次")
    ax_b.set_ylim(17.4, 22.9)
    ax_b.set_yticks([18, 19, 20, 21, 22])
    ax_b.set_title("安全余量触发离散的拆批跃迁")
    threshold_label_specs = [
        (thresholds["S004拆批"] * 100, 22.72, "S004拆批\n22.79%", "#777777", "right"),
        (thresholds["S008拆批"] * 100, 22.72, "S008拆批\n26.79%", "#777777", "left"),
        (thresholds["S008首批不可行"] * 100, 22.72, "不可行阈值\n34.54%", COLORS["accent"], "left"),
    ]
    for x_text, y_text, label, color, alignment in threshold_label_specs:
        ax_b.text(
            x_text + (-0.25 if alignment == "right" else 0.25),
            y_text,
            label,
            ha=alignment,
            va="top",
            fontsize=6.1,
            color=color,
        )
    add_panel_label(ax_b, "b")

    # c | 完整能耗。
    energy = np.array([result["energy_kwh"] for result in results], dtype=float)
    ax_c.plot(rho_pct, energy, color=COLORS["accent"], lw=1.9, marker="o", ms=2.8)
    ax_c.axvspan(infeasible_start, rho_pct.max(), color=COLORS["infeasible"], zorder=0)
    ax_c.set_ylabel("完整运输能耗 (kWh)")
    ax_c.set_title("新增架次推高总任务能耗")
    add_panel_label(ax_c, "c")

    # d | 累计时间。
    time_h = np.array([result["time_h"] for result in results], dtype=float)
    ax_d.plot(rho_pct, time_h, color=COLORS["B"], lw=1.9, marker="o", ms=2.8)
    ax_d.axvspan(infeasible_start, rho_pct.max(), color=COLORS["infeasible"], zorder=0)
    ax_d.set_ylabel("累计作业时间 (h)")
    ax_d.set_title("拆批同步增加累计作业时间")
    add_panel_label(ax_d, "d")

    for ax in axes.ravel():
        ax.set_xlim(rho_pct.min(), rho_pct.max())
        ax.set_xticks(np.arange(10, 41, 5))
        ax.set_xlabel("返航安全余量 (%)")
        ax.grid(axis="y", color=COLORS["grid"], lw=0.6, alpha=0.75)
        add_threshold_lines(ax, thresholds, include_labels=False)

    fig.suptitle(
        "返航安全余量对最大安全载荷与货箱组批的影响",
        fontsize=10,
        fontweight="bold",
        y=0.995,
    )
    fig.subplots_adjust(left=0.095, right=0.985, bottom=0.10, top=0.91, wspace=0.30, hspace=0.40)

    fig.savefig(f"{FIGURE_STEM}.svg", bbox_inches="tight")
    fig.savefig(f"{FIGURE_STEM}.pdf", bbox_inches="tight")
    fig.savefig(f"{FIGURE_STEM}.png", dpi=300, bbox_inches="tight")
    fig.savefig(
        f"{FIGURE_STEM}.tiff",
        dpi=600,
        bbox_inches="tight",
        pil_kwargs={"compression": "tiff_lzw"},
    )
    plt.close(fig)


def print_key_table(results):
    print("\n安全余量敏感性分析：")
    print("余量   架次    能耗/kWh    时间/h      机型配置")
    for result in results:
        if round(result["rho"], 2) not in TABLE_RHO_VALUES:
            continue
        if result["batching_feasible"]:
            counts = result["model_counts"]
            configuration = "、".join(
                f"{model}型{counts.get(model, 0)}次" for model in ("A", "B", "C") if counts.get(model, 0)
            )
            print(
                f'{result["rho"]:>4.0%}  {int(result["sorties"]):>4d}  '
                f'{result["energy_kwh"]:>10.4f}  {result["time_h"]:>8.4f}  {configuration}'
            )
        else:
            print(f'{result["rho"]:>4.0%}    --          --        --  不可行')


def main():
    base = load_base_module()
    safe_at_20, routes, reference_rows = base.load_safe_loads_routes_and_reference_energy()
    parameters = base.load_drone_parameters()
    boxes_by_service = base.load_boxes()

    # 双重公式核验：先核对基础代码，再核对20%安全余量下的二分载荷矩阵。
    formula_error = base.validate_energy_formula(reference_rows, routes, parameters)
    computed_20, _ = build_safe_load_matrix(base, routes, parameters, 0.20)
    payload_error = max(
        abs(computed_20[service][model] - safe_at_20[service][model])
        for service in safe_at_20
        for model in parameters
    )
    if payload_error > 1e-3:
        raise AssertionError(
            f"20%安全余量载荷矩阵核验失败，最大误差={payload_error:.8f} kg"
        )

    results = [
        solve_one_rho(base, float(rho), routes, parameters, boxes_by_service)
        for rho in RHO_VALUES
    ]
    thresholds = calculate_critical_reserves(
        base, routes, parameters, boxes_by_service
    )

    export_source_data(results, parameters)
    make_figure(results, parameters, thresholds)
    print_key_table(results)

    print(f"\n能耗公式核验最大误差：{formula_error:.8f} kWh")
    print(f"20%安全载荷矩阵核验最大误差：{payload_error:.8f} kg")
    for name, value in thresholds.items():
        print(f"{name}临界安全余量：{value:.4%}")
    print(f"\n汇总数据：{SUMMARY_CSV}")
    print(f"详细数据：{DETAIL_CSV}")
    print(f"图片预览：{FIGURE_STEM}.png")
    print(f"矢量图片：{FIGURE_STEM}.svg / {FIGURE_STEM}.pdf")
    print(f"印刷图片：{FIGURE_STEM}.tiff")


if __name__ == "__main__":
    main()
