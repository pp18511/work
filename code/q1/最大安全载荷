import matplotlib

matplotlib.use("TkAgg")

import matplotlib.pyplot as plt
import numpy as np

# ------------------------------------------------------------
# 中文字体
# ------------------------------------------------------------

plt.rcParams["font.sans-serif"] = [
    "Microsoft YaHei",
    "SimHei"
]

plt.rcParams["axes.unicode_minus"] = False


# ------------------------------------------------------------
# 生成热力图矩阵
#
# 行：A/B/C
# 列：S001~S015
# ------------------------------------------------------------

heatmap_df = result_df.pivot(
    index="机型",
    columns="服务区",
    values="最大安全载荷/kg"
)

# 固定机型顺序
heatmap_df = heatmap_df.reindex(
    ["A", "B", "C"]
)

# 固定服务区顺序
service_order = [
    f"S{i:03d}"
    for i in range(1, 16)
]

heatmap_df = heatmap_df.reindex(
    columns=service_order
)


# ------------------------------------------------------------
# 绘图
# ------------------------------------------------------------

fig, ax = plt.subplots(
    figsize=(15, 4.8)
)

data = heatmap_df.values

im = ax.imshow(
    data,
    aspect="auto",
    cmap="YlOrRd"
)


# ------------------------------------------------------------
# 坐标轴
# ------------------------------------------------------------

ax.set_xticks(
    np.arange(
        len(heatmap_df.columns)
    )
)

ax.set_xticklabels(
    heatmap_df.columns,
    rotation=45,
    ha="right"
)

ax.set_yticks(
    np.arange(
        len(heatmap_df.index)
    )
)

ax.set_yticklabels(
    [
        "A型无人机",
        "B型无人机",
        "C型无人机"
    ]
)


ax.set_xlabel(
    "服务区",
    fontsize=12
)

ax.set_ylabel(
    "无人机机型",
    fontsize=12
)

ax.set_title(
    "三种机型在不同服务区的最大安全载荷热力图",
    fontsize=15,
    pad=15
)


# ------------------------------------------------------------
# 在每个格子里面写载荷数值
# ------------------------------------------------------------

threshold = (
    np.nanmax(data)
    + np.nanmin(data)
) / 2


for i in range(data.shape[0]):

    for j in range(data.shape[1]):

        value = data[i, j]

        if np.isnan(value):
            continue

        # 深色区域使用白字
        text_color = (
            "white"
            if value > threshold
            else "black"
        )

        ax.text(
            j,
            i,
            f"{value:.1f}",
            ha="center",
            va="center",
            fontsize=9,
            color=text_color
        )


# ------------------------------------------------------------
# 颜色条
# ------------------------------------------------------------

cbar = fig.colorbar(
    im,
    ax=ax,
    pad=0.02
)

cbar.set_label(
    "最大安全载荷 / kg",
    rotation=90
)


# ------------------------------------------------------------
# 保存
# ------------------------------------------------------------

plt.tight_layout()

plt.savefig(
    "图1_三机型最大安全载荷热力图.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()