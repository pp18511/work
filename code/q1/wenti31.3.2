"""问题一对比实验总体代码。

对比内容：
1. 仅用 A 型、仅用 B 型、仅用 C 型；
2. 混合机型下“架次 -> 时间 -> 能耗”；
3. 混合机型下“架次 -> 能耗 -> 时间”。

全部方案采用相同的货箱唯一分配、不可拆分、首批保障、载质量、
装载体积和返航安全载荷约束。代码使用精确子集划分动态规划求解，
它与本题按服务区分解后的集合划分整数规划具有相同的全局最优解。

关键公式：
L_g(q) = L_g0 - (L_g0 - L_gF) * (q / Q_g) ** (3 / 2)
"""

from __future__ import annotations

import csv
import json
from collections import Counter
from functools import lru_cache
from pathlib import Path

from openpyxl import load_workbook


SAFE_LOAD_FILE = Path(r"D:\pycharm\test2\pythonProject2\最大安全载荷计算结果.xlsx")
DATA_DIR = Path(
    r"C:\Users\admin\Desktop\第二十三届中国研究生数学建模竞赛 - 中文题目"
    r"\中文题目\D题\数据\无人机应急物资运输基础数据"
)
DEMAND_FILE = DATA_DIR / "物资需求与配送时限.xlsx"
DRONE_FILE = DATA_DIR / "运输无人机数据.xlsx"

SCRIPT_DIR = Path(__file__).resolve().parent
OUTPUT_JSON = SCRIPT_DIR / "问题一_机型与目标优先级对比结果.json"
OUTPUT_CSV = SCRIPT_DIR / "问题一_机型与目标优先级对比结果.csv"

G0 = 9.81
JOULES_PER_KWH = 3.6e6


def load_safe_loads_routes_and_reference_energy():
    """读取安全载荷、航段参数以及题目公式生成的参考能耗。"""
    workbook = load_workbook(SAFE_LOAD_FILE, data_only=True, read_only=True)

    matrix = workbook["最大安全载荷矩阵"]
    header = next(matrix.iter_rows(min_row=1, max_row=1, values_only=True))
    model_names = [str(value) for value in header[1:4]]
    safe_loads = {}
    for row in matrix.iter_rows(min_row=2, values_only=True):
        if row[0] is None:
            continue
        safe_loads[str(row[0])] = {
            model_names[index]: float(row[index + 1]) for index in range(3)
        }

    detail = workbook["详细计算结果"]
    routes = {}
    reference_rows = []
    for row in detail.iter_rows(min_row=2, values_only=True):
        if row[0] is None:
            continue
        service = str(row[0])
        model = str(row[1])
        routes.setdefault(
            service,
            {
                "distance_m": float(row[2]) * 1000.0,
                "outbound_climb_m": float(row[3]),
                "return_climb_m": float(row[4]),
            },
        )
        reference_rows.append(
            {
                "service": service,
                "model": model,
                "safe_payload_kg": float(row[6]),
                "reference_energy_kwh": float(row[12]),
            }
        )
    return safe_loads, routes, reference_rows


def load_drone_parameters():
    """读取 A、B、C 三种运输无人机参数。"""
    sheet = load_workbook(DRONE_FILE, data_only=True, read_only=True).active
    parameters = {}
    for row in sheet.iter_rows(values_only=True):
        if row[0] not in {"A", "B", "C"} or not isinstance(row[4], (int, float)):
            continue
        parameters[str(row[0])] = {
            "empty_mass_kg": float(row[2]),
            "rated_payload_kg": float(row[3]),
            "volume_capacity_m3": float(row[4]),
            "cruise_speed_mps": float(row[5]),
            "empty_range_m": float(row[6]),
            "full_range_m": float(row[7]),
            "usable_energy_kwh": float(row[8]),
            "reserve_fraction": float(row[9]) / 100.0,
            "prep_s": float(row[10]),
            "load_per_box_s": float(row[11]),
            "handover_base_s": float(row[12]),
            "handover_per_box_s": float(row[13]),
            "climb_speed_mps": float(row[14]),
            "descent_speed_mps": float(row[15]),
            "climb_efficiency": float(row[16]),
        }
        if len(parameters) == 3:
            break
    return parameters


def load_boxes():
    """读取80个不可拆分货箱，并按服务区组织。"""
    sheet = load_workbook(DEMAND_FILE, data_only=True, read_only=True)["逐箱货箱清单"]
    boxes_by_service = {}
    for row in sheet.iter_rows(min_row=2, values_only=True):
        if row[0] is None:
            continue
        box = {
            "box_id": str(row[0]),
            "service": str(row[1]),
            "mass_kg": float(row[3]),
            "volume_m3": float(row[4]),
            "first_required": str(row[5]) == "是",
        }
        boxes_by_service.setdefault(box["service"], []).append(box)
    return boxes_by_service


def equivalent_range_m(model, payload_kg):
    """题面公式：载荷比例必须取3/2次幂，不能写成线性关系。"""
    ratio = payload_kg / model["rated_payload_kg"]
    return model["empty_range_m"] - (
        model["empty_range_m"] - model["full_range_m"]
    ) * ratio ** 1.5


def batch_energy_kwh(route, model, payload_kg):
    """计算单服务区直接往返任务的完整运输能耗。"""
    loaded_range = equivalent_range_m(model, payload_kg)
    outbound_horizontal = (
        model["usable_energy_kwh"] * route["distance_m"] / loaded_range
    )
    return_horizontal = (
        model["usable_energy_kwh"]
        * route["distance_m"]
        / model["empty_range_m"]
    )
    outbound_climb = (
        (model["empty_mass_kg"] + payload_kg)
        * G0
        * route["outbound_climb_m"]
        / (model["climb_efficiency"] * JOULES_PER_KWH)
    )
    return_climb = (
        model["empty_mass_kg"]
        * G0
        * route["return_climb_m"]
        / (model["climb_efficiency"] * JOULES_PER_KWH)
    )
    return outbound_horizontal + return_horizontal + outbound_climb + return_climb


def batch_operation_time_s(route, model, box_count):
    """准备、装载、去返程飞行和货物交接的累计作业时间。"""
    outbound_flight = (
        route["outbound_climb_m"] / model["climb_speed_mps"]
        + route["distance_m"] / model["cruise_speed_mps"]
        + route["return_climb_m"] / model["descent_speed_mps"]
    )
    return_flight = (
        route["return_climb_m"] / model["climb_speed_mps"]
        + route["distance_m"] / model["cruise_speed_mps"]
        + route["outbound_climb_m"] / model["descent_speed_mps"]
    )
    ground_operation = (
        model["prep_s"]
        + box_count * model["load_per_box_s"]
        + model["handover_base_s"]
        + box_count * model["handover_per_box_s"]
    )
    return outbound_flight + return_flight + ground_operation


def validate_energy_formula(reference_rows, routes, parameters, tolerance=1e-4):
    """用安全载荷明细表逐行核验能耗公式，防止再次误写。"""
    errors = []
    for item in reference_rows:
        calculated = batch_energy_kwh(
            routes[item["service"]],
            parameters[item["model"]],
            item["safe_payload_kg"],
        )
        error = abs(calculated - item["reference_energy_kwh"])
        errors.append(error)
        if error > tolerance:
            raise AssertionError(
                f'能耗公式核验失败：{item["service"]}-{item["model"]}，'
                f'计算值={calculated:.8f}，参考值={item["reference_energy_kwh"]:.8f}，'
                f'误差={error:.8f} kWh'
            )
    return max(errors)


def pareto_prune(options):
    """删除同一货箱子集下能耗和时间均不占优的机型选项。"""
    retained = []
    for candidate in options:
        dominated = False
        for other in options:
            if other is candidate:
                continue
            no_worse = (
                other["energy_kwh"] <= candidate["energy_kwh"] + 1e-12
                and other["time_s"] <= candidate["time_s"] + 1e-9
            )
            strictly_better = (
                other["energy_kwh"] < candidate["energy_kwh"] - 1e-12
                or other["time_s"] < candidate["time_s"] - 1e-9
            )
            if no_worse and strictly_better:
                dominated = True
                break
        if not dominated:
            retained.append(candidate)
    return retained


def solve_service(
    service,
    boxes,
    safe_loads,
    routes,
    parameters,
    allowed_models,
    objective_order,
):
    """精确求解一个服务区的货箱子集划分。"""
    n = len(boxes)
    full_mask = (1 << n) - 1
    mandatory_mask = sum(
        1 << index for index, box in enumerate(boxes) if box["first_required"]
    )

    mass = [0.0] * (1 << n)
    volume = [0.0] * (1 << n)
    count = [0] * (1 << n)
    for mask in range(1, 1 << n):
        bit = mask & -mask
        index = bit.bit_length() - 1
        previous = mask ^ bit
        mass[mask] = mass[previous] + boxes[index]["mass_kg"]
        volume[mask] = volume[previous] + boxes[index]["volume_m3"]
        count[mask] = count[previous] + 1

    candidates = {}
    for mask in range(1, 1 << n):
        options = []
        for model_name in allowed_models:
            model = parameters[model_name]
            if (
                mass[mask] <= safe_loads[service][model_name] + 1e-9
                and volume[mask] <= model["volume_capacity_m3"] + 1e-12
            ):
                options.append(
                    {
                        "model": model_name,
                        "energy_kwh": batch_energy_kwh(
                            routes[service], model, mass[mask]
                        ),
                        "time_s": batch_operation_time_s(
                            routes[service], model, count[mask]
                        ),
                    }
                )
        if options:
            candidates[mask] = pareto_prune(options)

    def objective_key(value):
        metrics = {
            "sorties": value[0],
            "energy": value[1],
            "time": value[2],
        }
        return tuple(metrics[name] for name in objective_order)

    @lru_cache(maxsize=None)
    def partition(mask):
        if mask == 0:
            return 0, 0.0, 0.0, ()

        anchor = mask & -mask
        best = None
        subset = mask
        while subset:
            if subset & anchor and subset in candidates:
                remainder = partition(mask ^ subset)
                for option in candidates[subset]:
                    value = (
                        remainder[0] + 1,
                        remainder[1] + option["energy_kwh"],
                        remainder[2] + option["time_s"],
                        ((subset, option["model"]),) + remainder[3],
                    )
                    if best is None or objective_key(value) < objective_key(best):
                        best = value
            subset = (subset - 1) & mask

        if best is None:
            raise RuntimeError(f"{service}不存在可行货箱划分，mask={mask}")
        return best

    best = None
    for first_mask, options in candidates.items():
        if first_mask & mandatory_mask != mandatory_mask:
            continue
        remainder = partition(full_mask ^ first_mask)
        for option in options:
            value = (
                remainder[0] + 1,
                remainder[1] + option["energy_kwh"],
                remainder[2] + option["time_s"],
                ((first_mask, option["model"]),) + remainder[3],
            )
            if best is None or objective_key(value) < objective_key(best):
                best = value

    if best is None:
        raise RuntimeError(f"{service}不存在满足首批要求的方案")
    return best


def solve_scenario(
    name,
    allowed_models,
    objective_order,
    safe_loads,
    routes,
    parameters,
    boxes_by_service,
):
    total_sorties = 0
    total_energy = 0.0
    total_time = 0.0
    model_counts = Counter()

    for service in sorted(boxes_by_service):
        result = solve_service(
            service,
            boxes_by_service[service],
            safe_loads,
            routes,
            parameters,
            allowed_models,
            objective_order,
        )
        total_sorties += result[0]
        total_energy += result[1]
        total_time += result[2]
        for _, model_name in result[3]:
            model_counts[model_name] += 1

    return {
        "方案": name,
        "目标优先序": "→".join(
            {"sorties": "架次", "energy": "能耗", "time": "时间"}[item]
            for item in objective_order
        ),
        "往返架次": total_sorties,
        "完整能耗_kWh": total_energy,
        "累计时间_s": total_time,
        "累计时间_h": total_time / 3600.0,
        "机型配置": "、".join(
            f"{model}型{count}次" for model, count in sorted(model_counts.items())
        ),
    }


def write_results(results):
    OUTPUT_JSON.write_text(
        json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    fieldnames = list(results[0])
    with OUTPUT_CSV.open("w", encoding="utf-8-sig", newline="") as file:
        writer = csv.DictWriter(file, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(results)


def main():
    safe_loads, routes, reference_rows = load_safe_loads_routes_and_reference_energy()
    parameters = load_drone_parameters()
    boxes_by_service = load_boxes()

    max_formula_error = validate_energy_formula(reference_rows, routes, parameters)
    print(f"能耗公式核验通过，最大绝对误差={max_formula_error:.8f} kWh")

    scenarios = [
        ("仅用A型", ("A",), ("sorties", "energy", "time")),
        ("仅用B型", ("B",), ("sorties", "energy", "time")),
        ("仅用C型", ("C",), ("sorties", "energy", "time")),
        (
            "混合机型整数规划：架次→时间→能耗",
            tuple(parameters),
            ("sorties", "time", "energy"),
        ),
        (
            "混合机型整数规划：架次→能耗→时间",
            tuple(parameters),
            ("sorties", "energy", "time"),
        ),
    ]

    results = [
        solve_scenario(
            name,
            allowed_models,
            objective_order,
            safe_loads,
            routes,
            parameters,
            boxes_by_service,
        )
        for name, allowed_models, objective_order in scenarios
    ]

    write_results(results)
    print("\n对比结果：")
    for result in results:
        print(
            f'{result["方案"]}: '
            f'架次={result["往返架次"]}, '
            f'能耗={result["完整能耗_kWh"]:.6f} kWh, '
            f'时间={result["累计时间_h"]:.6f} h, '
            f'配置={result["机型配置"]}'
        )
    print(f"\nJSON结果：{OUTPUT_JSON}")
    print(f"CSV结果：{OUTPUT_CSV}")


if __name__ == "__main__":
    main()
